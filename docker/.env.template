# Build
BUILD_CONFIGURATION=Release # Debug
BUILD_IMAGE_CONFIGURATION=release # debug

# Docker-External Ports
API_HTTPS_PORT=7070
API_HEALTH_PORT=7001
DATABASE_PORT=7002
MESSAGEBUS_AMQP_PORT=7003
MESSAGEBUS_MANAGEMENT_PORT=7004
TELEMETRY_OTLP_GRPC_PORT=7005
TELEMETRY_OTLP_HTTP_PORT=7006
SMTP_EXTERNAL=7575
SMTP_UI=7777

# Common Environment 
# Worker and seed only; the api service overrides it in docker-compose.yml (HTTPS)
ASPNETCORE_URLS=http://+:8080;http://+:5001
API_CERTIFICATE_PASSWORD=password
ASPNETCORE_ENVIRONMENT=Production # Development

Diagnostics__OpenTelemetry__Enabled=true 
OTEL_EXPORTER_OTLP_ENDPOINT=http://telemetry:18889
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Api
# Transport: Rest (default) | Grpc | GrpcWeb (GrpcWeb also serves native gRPC)
Transport__Mode=Rest
Modules__Users__Auth__Google__ClientId=
Modules__Users__Auth__Google__ClientSecret=
Modules__Users__Sender__ConfirmationUrl=https://bbc98ddcede2.ngrok-free.app/confirmEmail
Modules__Users__Sender__ResetUrl=https://bbc98ddcede2.ngrok-free.app/resetPassword
Modules__DataSource__Brokers__IsCluster=true
# Let many users register the same broker URL+port (needed for the seeded shared broker)
Modules__DataSource__Brokers__AllowSharedBrokers=true
# Anonymous (auth endpoint) rate limiter per IP; raised so the seed container can register 100 users quickly
RateLimiter__Anonymous__Token__TokenLimit=300
RateLimiter__Anonymous__Token__TokensPerPeriod=100

# Seed
Seed__Instance=https://api:8443/api
Seed__DefaultUser__Devices__PicoController__GlobalTopic=prod/controller
# Generated users: Count users named by EmailPattern ({0} = 1-based index), all sharing one broker
Seed__GeneratedUsers__Count=100
Seed__GeneratedUsers__EmailPattern=user{0}@senswave.com
Seed__GeneratedUsers__Password=User123456!
Seed__GeneratedUsers__Broker__Create=true
Seed__GeneratedUsers__Broker__Name=Shared Broker
# Leave Url empty to reuse the DefaultUser broker; set all four to point generated users at another broker
Seed__GeneratedUsers__Broker__Url=
Seed__GeneratedUsers__Broker__Port=8883
Seed__GeneratedUsers__Broker__Username=
Seed__GeneratedUsers__Broker__Password=
Seed__GeneratedUsers__Devices__PicoController__GlobalTopic=prod/controller/{0}

# Database
PostgreSql__Host=database
PostgreSql__Port=5432
PostgreSql__Database=senswave
PostgreSql__Username=postgres
PostgreSql__Password=postgres

# Message Bus
MessageBus__Type=RabbitMq
MessageBus__RabbitMq__Host=rabbitmq://messagebus
MessageBus__RabbitMq__Username=guest
MessageBus__RabbitMq__Password=guest

# Smtp
Smtp__Enabled=true
Smtp__User=test
Smtp__Password=test
Smtp__Host=smtp
Smtp__Port=25
Smtp__SenderEmail=test_sender@senswave.com
Smtp__UseSsl=false
