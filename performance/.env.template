# Host ports, one per transport (each maps to container port 8443, HTTPS)
REST_PORT=8001
GRPC_PORT=8002
GRPCWEB_PORT=8003

# Same limits for every API container, so the transports compete on equal resources
API_CPUS=2
API_MEMORY=1g

# Must match the password given to docker/generate-cert.sh
API_CERTIFICATE_PASSWORD=password

# Database (one Postgres, one database per API container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
