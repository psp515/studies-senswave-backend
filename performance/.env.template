# =====================================================================================================================
# Senswave performance platform: one settings file for every service.
#
#   cp performance/.env.template performance/.env      (performance/.env is git-ignored)
#
# Who reads it:
#   [stack]   the VM stack: APIs, seed, PerfAgent, Alloy   docker compose ... --env-file performance/.env
#   [runner]  the load side: PerfRunner, k6, PerfStream    performance/runner/compose.yml (env_file: ../.env)
#   [both]    the same value is needed on both sides
#
# Locally both sides run on one machine and use this one file. On Azure the VM and the load machine each get a copy
# of the same file (values that only the other side uses are ignored).
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. Required secret  [both]
# ---------------------------------------------------------------------------------------------------------------------
# Bearer token between PerfRunner and PerfAgent. At least 32 characters; the template value is rejected.
# Generate once: openssl rand -hex 32
AGENT_TOKEN=change-me-to-a-long-random-string


# ---------------------------------------------------------------------------------------------------------------------
# 2. Environment and build  [stack]
# ---------------------------------------------------------------------------------------------------------------------
# Alloy label `env` on every metric: local | azure.
PERF_ENV=local
# Commit under test, baked into the API image label at build time. A .env file cannot run $(...):
# export GIT_SHA=$(git rev-parse HEAD) in the shell before `up --build` (an exported variable wins over this file).
GIT_SHA=unknown


# ---------------------------------------------------------------------------------------------------------------------
# 3. Host name, ports and TLS  [stack]
# ---------------------------------------------------------------------------------------------------------------------
# Host name clients use for the API; also a network alias of every API container, so the seed resolves it internally.
# Local: api (matches docker/generate-cert.sh). Azure: the DNS name, e.g. perf.example.com.
PERF_API_HOST=api
API_PORT=8443
AGENT_PORT=9443
# Published interface of the API and agent ports. Local default (from local/alloy-defaults.env.local): 127.0.0.1.
# Azure default: 0.0.0.0 (restricted by the NSG). Uncomment only to override.
# API_BIND=127.0.0.1
# AGENT_BIND=127.0.0.1

# Directory (host path, relative to the compose file) holding senswave.api.pfx / senswave.api.crt (and mqtt.crt locally).
CERT_DIR=../../docker/https
API_CERTIFICATE_PASSWORD=password

# Trust stores. Each REPLACES the container's system CA bundle.
#   SEED_SSL_CERT_FILE: what the seed trusts when calling the API.
#     local: /https/senswave.api.crt (self-signed)  |  Azure: /etc/ssl/certs/ca-certificates.crt (Let's Encrypt)
#   API_SSL_CERT_FILE: what the API trusts when connecting to the MQTT broker over TLS.
#     local: /https/mqtt.crt (Mosquitto stand-in)   |  Azure: /etc/ssl/certs/ca-certificates.crt (public broker cert)
SEED_SSL_CERT_FILE=/https/senswave.api.crt
API_SSL_CERT_FILE=/https/mqtt.crt


# ---------------------------------------------------------------------------------------------------------------------
# 4. CPU and memory of the stack  [stack]
# ---------------------------------------------------------------------------------------------------------------------
# API_CPUSET: the API's logical CPUs (a full physical core pair; check sibling pairs with `lscpu -e`).
# SIDE_CPUSET: agent, Alloy, local Postgres and Mosquitto. Machines with fewer than 4 vCPUs: both 0-1.
API_CPUSET=2-3
API_CPUS=2
API_MEMORY=4g
SIDE_CPUSET=0-1


# ---------------------------------------------------------------------------------------------------------------------
# 5. PostgreSQL  [stack]
# ---------------------------------------------------------------------------------------------------------------------
# Local: the `database` container. Azure: <server-name>.postgres.database.azure.com and the Flexible Server admin.
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# TLS of Alloy's PostgreSQL exporter connection. Local: disable. Azure: require. The password goes into its URL as is:
# percent-encode characters such as @ : / ? # in it, or use a password without them.
POSTGRES_SSLMODE=disable


# ---------------------------------------------------------------------------------------------------------------------
# 6. Seed data  [stack]
# ---------------------------------------------------------------------------------------------------------------------
# Generated users for `prepare`. Campaigns use the first users.count of them. Use 100 for a quick first local test.
# Each user gets a Pico controller with 30 operations and a 10x4 dashboard with 40 widgets (about 130 API calls).
SEED_USER_COUNT=2000
# Users seeded at the same time (1 = one after another). Watch the seed log for errors when raising it.
SEED_PARALLELISM=8


# ---------------------------------------------------------------------------------------------------------------------
# 7. MQTT broker
# ---------------------------------------------------------------------------------------------------------------------
# [stack] Broker the seeded users' broker entries point to; the API connects to it over TLS.
#   local: mqtt / 8883 (Mosquitto TLS listener)  |  Azure: the external broker's host and TLS port
SEED_BROKER_URL=mqtt
SEED_BROKER_PORT=8883
SEED_BROKER_USERNAME=perf
SEED_BROKER_PASSWORD=perf

# [runner] Broker PerfStream publishes to as the device in S6 (the same broker, as seen from the load side).
#   local: host.docker.internal / 1883 / no TLS  |  Azure: the external broker's host, TLS port, MQTT_TLS=true
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# [runner] Credentials the runner sends when it starts each user's broker client in the API (S5, S6).
BROKER_CLIENT_USERNAME=perf
BROKER_CLIENT_PASSWORD=perf


# ---------------------------------------------------------------------------------------------------------------------
# 8. Grafana Cloud  [both]
# ---------------------------------------------------------------------------------------------------------------------
# Optional locally: leave commented and Alloy uses local placeholders, `run` then skips the server export.
# Values from grafana.com > your stack > Details. One access policy token with
#   metrics:read, metrics:write, traces:read, traces:write
# serves everything: Alloy pushes with it [stack], PerfRunner exports with it and k6 pushes with it [runner].
#
# GRAFANA_CLOUD_TOKEN=glc_...
#
# OpenTelemetry card [stack]: OTLP endpoint (ends in /otlp) and Instance ID.
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# GRAFANA_CLOUD_OTLP_USER=
#
# Prometheus card [both]: Remote Write endpoint (ends in /api/prom/push) and Username / Instance ID.
# The runner derives the query URL from it (the same URL without /push).
# GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-eu-west-2.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROM_USER=
#
# Tempo card [runner]: URL (ends in /tempo) and User. Only for campaigns with export.traces = true.
# GRAFANA_CLOUD_TEMPO_URL=https://tempo-prod-XX-prod-eu-west-2.grafana.net/tempo
# GRAFANA_CLOUD_TEMPO_USER=


# ---------------------------------------------------------------------------------------------------------------------
# 9. Load side options  [runner]
# ---------------------------------------------------------------------------------------------------------------------
# true: k6 also pushes its client metrics to Grafana Cloud (Prometheus remote write, section 8) during measured runs.
# The thesis data comes from the files either way; this is for live dashboards only.
K6_REMOTE_WRITE=false

# Azure Blob container SAS URL with write permission, for `perfrunner archive`. Not needed locally.
ARCHIVE_SAS_URL=
