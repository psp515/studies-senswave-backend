# Local-only defaults, loaded first by local/compose.yml's include; stack/.env wins when it sets the same variable.
# Environment label (the Azure stack/compose.yml has no default: stack/.env must set PERF_ENV=azure there).
PERF_ENV=local
# Publish the API and agent ports on the loopback only (the Azure setup keeps the 0.0.0.0 default).
API_BIND=127.0.0.1
AGENT_BIND=127.0.0.1
# Placeholders so Alloy starts without Grafana Cloud.
GRAFANA_CLOUD_OTLP_ENDPOINT=http://localhost:1
GRAFANA_CLOUD_PROM_URL=http://localhost:1/api/prom/push
